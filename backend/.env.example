# Copy to .env and fill in. .env is git-ignored.
CLAUDE_API_KEY=

# Only for docker-compose.prod.yml (the VPS). Local dev does not need these.
# Use a long random password, for example: openssl rand -base64 24
DB_PASSWORD=
# Port on the server that the app calls (default 8081).
BACKEND_PORT=8081
# 0.0.0.0 = open to the internet. Use 127.0.0.1 when Caddy (HTTPS) is in front.
BACKEND_BIND=0.0.0.0
# Optional: override the Claude model.
# CLAUDE_MODEL=claude-haiku-5-5

# Admin web app API (/api/admin). See backlog/docs/features/doc-13 and the deploy guide.
# Signs the admin login cookie. At least 32 characters, for example: openssl rand -base64 48
ADMIN_JWT_SECRET=
# The first admin account. It is created at start-up only when no admin exists yet.
# The password needs 12+ characters. After the first start you can remove ADMIN_INITIAL_PASSWORD.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
# Set to false to run without the admin API (then ADMIN_JWT_SECRET is not needed).
# ADMIN_ENABLED=true
