# Database (matches the Postgres container we add in Lesson 3)
DB_URL=jdbc:postgresql://localhost:5432/saynata
DB_USER=saynata
DB_PASSWORD=change-me

# Public address of this API, and the websites allowed to call it (comma separated)
APP_PUBLIC_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Swagger UI and /v3/api-docs. Set to false in production.
DOCS_ENABLED=true

# LLM gate (Lesson 9). provider: fake = offline answers, no money spent.
LLM_PROVIDER=fake
LLM_DAILY_BUDGET_USD=5.00
LLM_COST_PER_CALL_USD=0.001
LLM_MAX_CALLS_PER_IP_PER_HOUR=30
