<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BackendBaseURL</key>
	<string>http://localhost:8081</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.luke.EnglishTranslation</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>saynata</string>
			</array>
		</dict>
	</array>
	<key>ClaudeAPIKey</key>
	<string>$(CLAUDE_API_KEY)</string>
	<key>DeepSeekAPIKey</key>
	<string>$(DEEPSEEK_API_KEY)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>OpenAIAPIKey</key>
	<string>$(OPENAI_API_KEY)</string>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>com.apple.developer.translation-ui-provider.network-access</key>
	<true/>
</dict>
</plist>
