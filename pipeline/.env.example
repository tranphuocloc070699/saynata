# Which LLM to use: gemini or deepseek
LLM_PROVIDER=gemini
# Optional: override requests per minute (Gemini free tier = 15)
# LLM_MAX_PER_MINUTE=15

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Paid, cheap: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
