# Claude API key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (cheap, ~$0.0004 per call) or claude-sonnet-5-5 (better definitions, ~$0.008 per call)
CLAUDE_MODEL=claude-haiku-5-5
# Optional: space out calls (0 = no pacing; the SDK retries 429s itself)
# LLM_MAX_PER_MINUTE=0

# Pixabay API key for media pass: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# The server Postgres (the source of truth for the bundled dictionary): used by `import-to-postgres` and `export`.
# `export` only reads from it. On the VPS, open an SSH tunnel first (guide doc-11, section "Dictionary pipeline").
# DATABASE_URL=postgresql://app:YOUR_DB_PASSWORD@localhost:55432/english_translation

# OpenAI API key for AI sense pictures (uv run pipeline media-generate, TASK-53): https://platform.openai.com/api-keys
# Billed per image (gpt-image-1-mini, low quality: about $0.003-0.004). Set a monthly limit in the OpenAI dashboard too.
OPENAI_API_KEY=
# Where the server serves media files; media-generate --link checks a file is there before it links it.
# MEDIA_BASE_URL=https://api.loffy.me/media
